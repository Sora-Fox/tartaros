+#include "early_init/framebuffer.hpp"
+#include <libk/ctype.hpp>  // Для isprint
+#include <libk/string.hpp> // Для memmove, memset
+#include <limits.h>        // Для USHRT_MAX
+#include <stddef.h>
+#include <stdint.h>
+#include "early_init/panic.hpp" // Для panic
+
+extern char _binary_font_psf_start;
+extern char _binary_font_psf_end;
+
+namespace {
+  constexpr uint32_t psf_magic = 0x864ab572;
+  struct [[gnu::packed]] psf_header
+  {
+    uint32_t magic;
+    uint32_t version;
+    uint32_t headersize;
+    uint32_t flags;
+    uint32_t numglyph;
+    uint32_t bytesperglyph;
+    uint32_t height;
+    uint32_t width;
+  };
+
+  static uint32_t* fb_base = nullptr;
+  static size_t fb_pitch = 0;
+  static size_t fb_width = 0;
+  static size_t fb_height = 0;
+
+  static psf_header* font = nullptr;
+  static uint16_t* unicode_table = nullptr;
+
+  alignas(16) static uint16_t unicode_buf[USHRT_MAX];
+
+  void init_psf()
+  {
+    font = reinterpret_cast<psf_header*>(&_binary_font_psf_start);
+    const auto font_end = reinterpret_cast<uintptr_t>(&_binary_font_psf_end);
+    if (font->magic != psf_magic || font->version != 0) {
+      panic("Invalid PSF font magic or version");
+    }
+    if (reinterpret_cast<uintptr_t>(font) + font->headersize > font_end) {
+      panic("Invalid PSF font header size");
+    }
+    if (font->flags == 0) {
+      return;
+    }
+    unicode_table = unicode_buf;
+    memset(unicode_table, 0, sizeof(unicode_buf));
+    auto* s = reinterpret_cast<unsigned char*>(font) + font->headersize +
+              font->numglyph * font->bytesperglyph;
+    uint16_t glyph = 0;
+
+    while (reinterpret_cast<uintptr_t>(s) < font_end) {
+      uint16_t uc = static_cast<uint16_t>(*s);
+      if (uc == 0xFF) {
+        ++glyph;
+        ++s;
+        continue;
+      } else if (uc & 0x80) {
+        if ((uc & 0x20) == 0) {
+          uc = ((s[0] & 0x1F) << 6) | (s[1] & 0x3F);
+          s += 1;
+        } else if ((uc & 0x10) == 0) {
+          uc = (((s[0] & 0x0F) << 6) | (s[1] & 0x3F)) << 6 | (s[2] & 0x3F);
+          s += 2;
+        } else if ((uc & 0x08) == 0) {
+          uc = ((((s[0] & 0x07) << 6) | (s[1] & 0x3F)) << 6 | (s[2] & 0x3F)) << 6 |
+               (s[3] & 0x3F);
+          s += 3;
+        } else {
+          uc = 0;
+        }
+      }
+      if (uc < USHRT_MAX) {
+        unicode_table[uc] = glyph;
+      }
+      ++s;
+    }
+  }
+
+  void render_char(uint16_t c, int cx, int cy, uint32_t fg, uint32_t bg)
+  {
+    if (unicode_table) {
+      c = unicode_table[c];
+    }
+    if (c >= font->numglyph) {
+      c = 0;
+    }
+    auto* glyph = reinterpret_cast<unsigned char*>(font) + font->headersize +
+                  c * font->bytesperglyph;
+    const uint32_t bytes_per_line = (font->width + 7u) / 8u;
+    size_t offs = (cy * font->height * fb_pitch) + (cx * font->width * sizeof(uint32_t));
+
+    for (uint32_t y = 0; y < font->height; ++y) {
+      size_t line_offs = offs;
+      unsigned char* byte_ptr = glyph + y * bytes_per_line;
+      uint8_t bit_mask = 1u << 7;
+
+      for (uint32_t x = 0; x < font->width; ++x) {
+        reinterpret_cast<char*>(fb_base)[line_offs] = (*byte_ptr & bit_mask) ? fg : bg;
+        fb_base[line_offs / sizeof(uint32_t)] = (*byte_ptr & bit_mask) ? fg : bg;
+        bit_mask >>= 1;
+        if (bit_mask == 0) {
+          bit_mask = 1u << 7;
+          ++byte_ptr;
+        }
+        line_offs += sizeof(uint32_t);
+      }
+      offs += fb_pitch;
+    }
+  }
+
+  void scroll_up()
+  {
+    const size_t line_size = fb_pitch * font->height;
+    char* base = reinterpret_cast<char*>(fb_base);
+    memmove(base, base + line_size, line_size * (fb_height / font->height - 1));
+    memset(base + line_size * (fb_height / font->height - 1), 0, line_size);
+  }
+}
+
+void early::init_framebuffer(void* fb_ptr, int pitch, int w, int h)
+{
+  init_psf();
+  fb_base = static_cast<uint32_t*>(fb_ptr);
+  fb_pitch = static_cast<size_t>(pitch);
+  fb_width = static_cast<size_t>(w);
+  fb_height = static_cast<size_t>(h);
+  if (fb_base == nullptr || fb_pitch == 0 || fb_width == 0 || fb_height == 0 || !font) {
+    panic("Invalid framebuffer parameters or font");
+  }
+}
+
+void early::framebuffer_out_char(char ch)
+{
+  constexpr uint32_t fg = 0xFFFFFF;
+  constexpr uint32_t bg = 0x000000;
+
+  static int cursor_x = 0;
+  static int cursor_y = 0;
+
+  if (!font) {
+    panic("Framebuffer not initialized");
+  }
+
+  const int max_x = static_cast<int>(fb_width / font->width);
+  const int max_y = static_cast<int>(fb_height / font->height);
+
+  if (ch == '\n') {
+    render_char(' ', cursor_x, cursor_y, fg, bg);
+    cursor_x = 0;
+    ++cursor_y;
+  } else if (std::isprint(ch)) {
+    render_char(static_cast<uint16_t>(ch), cursor_x, cursor_y, fg, bg);
+    ++cursor_x;
+  } else {
+    return;
+  }
+  if (cursor_x >= max_x) {
+    cursor_x = 0;
+    ++cursor_y;
+  }
+  if (cursor_y >= max_y) {
+    scroll_up();
+    cursor_y = max_y - 1;
+  }
+  render_char('_', cursor_x, cursor_y, fg, bg);
+}
